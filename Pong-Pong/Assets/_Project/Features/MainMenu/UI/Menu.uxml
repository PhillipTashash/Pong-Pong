<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:Label text="Pong" name="Title" data-source-path="" parse-escape-sequences="true" style="-unity-text-align: upper-center;"/>
        <ui:Button text="Play" name="PlayButton"/>
        <ui:Button text="Quit" name="QuitButton"/>
        <ui:Label text="Player Names" name="NameChooseLabel" data-source-path="" parse-escape-sequences="true" style="-unity-text-align: upper-center;"/>
        <ui:TextField label="Left Player" placeholder-text="filler text" value="Player 1"/>
        <ui:TextField label="Right Player" placeholder-text="filler text" value="Player 2"/>
    </ui:VisualElement>
</ui:UXML>
